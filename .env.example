# wordforge DATABASE_URL — environment-dependent

# -----------------------------------------------------------------------------
# dev / prod  (this is what `wordforge run|ingest|plan|dlq|cache` talks to)
# -----------------------------------------------------------------------------
# Production is Ali Cloud RDS for PostgreSQL (serverless, Hangzhou).
# Credentials NEVER go in this file; store them in ~/.wordforge/prod.env
# (chmod 600) and `source ~/.wordforge/prod.env` before running commands,
# or export via direnv / 1Password CLI / etc.
#
# DATABASE_URL=postgresql+psycopg://<user>:<pw>@<ali-rds-host>:5432/wordforge

# -----------------------------------------------------------------------------
# test  (what pytest runs against — MUST be disposable)
# -----------------------------------------------------------------------------
# Uses the local docker container. Database name MUST contain 'test'; the
# session-scope guard in tests/conftest.py refuses non-localhost hosts and
# refuses db names that don't match. See CLAUDE.md "test vs prod DB" section.
#
# Start with:  docker compose up -d   (brings up wordforge-pg on :5433)
# Create once: docker exec wordforge-pg createdb -U wordforge wordforge_test
#
# DATABASE_URL=postgresql+psycopg://wordforge:wordforge@localhost:5433/wordforge_test

# Default for local dev (overwrite in ~/.wordforge/prod.env for prod access):
DATABASE_URL=postgresql+psycopg://wordforge:wordforge@localhost:5433/wordforge
